// Custom ACES Input Transform (IDT): DJI D-Log2 / D-Gamut2 -> ACES AP0
DEFINE_ACES_PARAM(IS_PARAMETRIC_ACES_TRANSFORM: 0)

__DEVICE__ inline float inv_dlog2(float x)
{
    if (x < 0.148314799066323f)
        return (x - 0.148314799066323f) / 2.9609352545492250f + 0.028961695254132f;
    else if (x < 0.304985337243402f)
        return _powf(2.0f, (x - 0.304985337243402f) / 0.059439398321493f + _log2f(0.18f));
    else
        return 475.0f / (_powf(2.0f, 16.285770761945304f) - 1.0f) *
               (_powf(2.0f, 16.285770761945304f * x) - 1.0f);
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B)
{
    // 1. Decode D-Log2 to linear reflection
    float r_lin = inv_dlog2(p_R);
    float g_lin = inv_dlog2(p_G);
    float b_lin = inv_dlog2(p_B);

    // 2. Matrix: D-Gamut2 -> ACES AP0 Linear
    float r_ap0 =  0.6788f * r_lin + 0.2163f * g_lin + 0.1049f * b_lin;
    float g_ap0 =  0.0437f * r_lin + 0.9329f * g_lin + 0.0234f * b_lin;
    float b_ap0 = -0.0031f * r_lin + 0.0232f * g_lin + 0.9799f * b_lin;

    return make_float3(r_ap0, g_ap0, b_ap0);
}